{
  "_comment": "Inpaint workflow for pose variants. Keeps the approved base figure pixel-identical outside the mask and repaints only the masked region, so identity is preserved. Node ids: 1 LoadImage (base), 2 LoadImage (mask, alpha channel carries the mask), 3 checkpoint, 4 VAEEncodeForInpaint, 5 positive, 6 negative, 7 KSampler, 8 VAEDecode, 9 SaveImage. Drive with tools/art/inpaint.py.",
  "1": {
    "class_type": "LoadImage",
    "_meta": {"title": "Load Base Figure"},
    "inputs": {"image": "PLACEHOLDER_BASE.png", "upload": "image"}
  },
  "2": {
    "class_type": "LoadImage",
    "_meta": {"title": "Load Mask"},
    "inputs": {"image": "PLACEHOLDER_MASK.png", "upload": "image"}
  },
  "3": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load SDXL Base"},
    "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}
  },
  "4": {
    "class_type": "VAEEncodeForInpaint",
    "_meta": {"title": "VAE Encode (for Inpainting)"},
    "inputs": {
      "pixels": ["1", 0],
      "vae": ["3", 2],
      "mask": ["2", 1],
      "grow_mask_by": 6
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"},
    "inputs": {"text": "", "clip": ["3", 1]}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"},
    "inputs": {"text": "", "clip": ["3", 1]}
  },
  "7": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"},
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.78,
      "model": ["3", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["4", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["7", 0], "vae": ["3", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save Image"},
    "inputs": {"filename_prefix": "fx_pose", "images": ["8", 0]}
  }
}